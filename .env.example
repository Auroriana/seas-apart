# Copy to .env.local. These switch App Check behaviour for local testing only.

# Browser dev: reCAPTCHA v3 site key registered for your Firebase Web app in App Check.
VITE_APPCHECK_WEB_SITE_KEY=
# Browser dev: "true" prints a debug token in the console that you register in the Firebase console.
VITE_APPCHECK_WEB_DEBUG=true
# Android build: "true" uses the App Check debug provider instead of Play Integrity.
# Needed if your sideloaded APK cannot pass Play Integrity. Weakens App Check; fine for a two-person private app.
VITE_APPCHECK_NATIVE_DEBUG=false
